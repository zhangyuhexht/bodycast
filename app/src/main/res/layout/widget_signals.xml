<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件 2×2「四信号」（22.35.0）：恢复云量 / 压力风速 / 能量湿度 / 睡眠云层一眼看全，
  底部一行「今天先补」。格子里的词是水平——和应用内一致，只给词不给数字。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_signals_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_signals_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textSize="12sp"
        android:textColor="@color/widget_label"
        android:text="@string/widget_signals_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_m0_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="10sp"
                android:textColor="@color/widget_label"
                android:text="@string/widget_signals_m0" />
            <TextView
                android:id="@+id/widget_m0_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/widget_ink"
                android:text="@string/widget_no_data_title" />

            <TextView
                android:id="@+id/widget_m2_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="1"
                android:textSize="10sp"
                android:textColor="@color/widget_label"
                android:text="@string/widget_signals_m2" />
            <TextView
                android:id="@+id/widget_m2_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/widget_ink"
                android:text="@string/widget_no_data_title" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_m1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="10sp"
                android:textColor="@color/widget_label"
                android:text="@string/widget_signals_m1" />
            <TextView
                android:id="@+id/widget_m1_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/widget_ink"
                android:text="@string/widget_no_data_title" />

            <TextView
                android:id="@+id/widget_m3_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="1"
                android:textSize="10sp"
                android:textColor="@color/widget_label"
                android:text="@string/widget_signals_m3" />
            <TextView
                android:id="@+id/widget_m3_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/widget_ink"
                android:text="@string/widget_no_data_title" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_signals_focus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/widget_accent"
        android:text="" />
</LinearLayout>
